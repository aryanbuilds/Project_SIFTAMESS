/* SIFTMesh cockpit layout (Epic O). Four zones by attention priority + a nav column. */

Screen {
    layout: vertical;
}

#vitals {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
    text-style: bold;
}

#taskbar {
    height: 1;
    padding: 0 1;
}

#ribbon {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* Filter + ledger-selector control row. */
#controls {
    height: 3;
    padding: 0 1;
}
#taskfilter {
    width: 2fr;
}
#ledgersel {
    width: 1fr;
}

/* Detail / gate / replay modals. */
GateScreen, TaskDetailScreen, ClaimDetailScreen, ReplayScreen {
    align: center middle;
}
TaskDetailScreen > TabbedContent, ClaimDetailScreen > VerticalScroll, ReplayScreen > VerticalScroll {
    width: 90%;
    height: 90%;
    border: round $accent;
    background: $surface;
}

/* Shown only while a launched run is initializing (toggled in code). */
#loading {
    height: 3;
    display: none;
}

#working {
    height: 1fr;
}

#tasks {
    width: 2fr;
    height: 1fr;
    border: round $primary;
}

#side {
    width: 1fr;
    height: 1fr;
    border: round $secondary;
}
#side Static {
    padding: 0 1;
}

#navcol {
    width: 1fr;
    height: 1fr;
}

#nav {
    height: 2fr;
    border: round $accent;
}

#filescroll {
    height: 1fr;
    border: round $accent;
}
#fileview {
    padding: 0 1;
}

#ticker {
    dock: bottom;
    height: 10;
    border: round $warning;
    background: $surface;
}

/* Responsive: stack the right column under the task table on narrow terminals. */
Screen.-narrow #working {
    layout: vertical;
}
Screen.-narrow #tasks,
Screen.-narrow #side,
Screen.-narrow #navcol {
    width: 1fr;
}

/* Onboarding + launcher + home spacing. */
#intro, #hometitle {
    padding: 1 1;
}
/* Minimal home: left recent-runs sidebar + centered hero. */
#homesplit {
    height: 1fr;
}
#homeside {
    width: 40%;
    min-width: 28;
    padding: 1 1;
}
#homeside #runs {
    height: 1fr;
    border: round $primary;
}
#rundetail, #firstrun {
    height: auto;
    color: $text-muted;
}
#hero {
    width: 1fr;
    align: center middle;
    content-align: center middle;
}
#herotitle {
    text-style: bold;
    text-align: center;
    padding: 1 0;
}
#hero Button {
    width: 24;
    margin: 1 0;
}
#herohint {
    color: $text-muted;
    text-align: center;
    padding: 1 0;
}
Screen.-narrow #homesplit {
    layout: vertical;
}
Screen.-narrow #homeside, Screen.-narrow #hero {
    width: 1fr;
}
#setupbtns, #homebtns, #scoperow, #judgerow, #agentbtns {
    height: auto;
    padding: 1 0;
}
#agentsel {
    height: 1fr;
    min-height: 6;
    border: round $primary;
}
/* Onboarding: readiness badge, guidance, judge tab. */
#readiness, #intro, #judgeintro, #judgedesc, #judgestatus, #guidance {
    height: auto;
    padding: 0 1;
}
#judgedesc {
    color: $text-muted;
}
#newrun {
    padding: 1 2;
}

/* Evidence picker (RunSetupScreen): breadcrumb + 2-pane (tree | picked) + search. */
#idrow, #navrow, #searchrow {
    height: auto;
    padding: 0 1;
}
#navrow Button {
    min-width: 6;
}
#evroot, #evsearch, #case, #base, #brief, #objective {
    width: 1fr;
}
#pickrow {
    height: 1fr;
    min-height: 12;
}
#pickrow #fstree {
    width: 1fr;
    border: round $primary;
}
#pickedcol {
    width: 1fr;
}
#picked {
    height: 1fr;
    border: round $primary;
}
#pickbtns {
    height: auto;
}
#evhits {
    height: auto;
    max-height: 10;
    border: round $accent;
}
#pickstatus {
    height: auto;
    color: $text-muted;
}
/* Narrow terminals: stack the picker panes vertically. */
Screen.-narrow #pickrow {
    layout: vertical;
}
Screen.-narrow #pickrow #fstree,
Screen.-narrow #pickedcol {
    width: 1fr;
}
