
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# uv / virtualenv (uv.lock IS committed; .venv is not)
.venv/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.json
htmlcov/

# SIFTMesh run output (case runs are generated, never committed; the committed
# regression fixture lives at tests/golden/recorded_run/ outside any case_runs/)
case_runs/

# Local case workspaces holding real evidence + run output (NEVER commit; multi-GB
# images/memory captures live here). Broad glob covers any case_* dir the maintainer
# creates (case_trail / case_trial / case_rocba / ...), so evidence can never be staged.
case_*/

# Per-machine project-scope config the TUI/setup writes (executor/agent preferences; no secrets).
# Local choice, not a repo default - keep it off the remote. Secrets live in ~/.config/siftmesh/.env.
siftmesh.toml

# Protocol SIFT case-workspace artifact (a global Stop-hook writes here on every claude run)
analysis/
