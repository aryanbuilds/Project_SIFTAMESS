/* SIFTMesh cockpit layout (Epic O). Four zones by attention priority + a nav column. */

Screen {
    layout: vertical;
}

#vitals {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $text;
    text-style: bold;
}

#taskbar {
    height: 1;
    padding: 0 1;
}

#ribbon {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

/* Filter + ledger-selector control row. */
#controls {
    height: 3;
    padding: 0 1;
}
#taskfilter {
    width: 2fr;
}
#ledgersel {
    width: 1fr;
}

/* Detail / gate / replay modals. */
GateScreen, TaskDetailScreen, ClaimDetailScreen, ReplayScreen {
    align: center middle;
}
TaskDetailScreen > TabbedContent, ClaimDetailScreen > VerticalScroll, ReplayScreen > VerticalScroll {
    width: 90%;
    height: 90%;
    border: round $accent;
    background: $surface;
}

/* Shown only while a launched run is initializing (toggled in code). */
#loading {
    height: 3;
    display: none;
}

#working {
    height: 1fr;
}

#tasks {
    width: 2fr;
    height: 1fr;
    border: round $primary;
}

#side {
    width: 1fr;
    height: 1fr;
    border: round $secondary;
}
#side Static {
    padding: 0 1;
}

#navcol {
    width: 1fr;
    height: 1fr;
}

#nav {
    height: 2fr;
    border: round $accent;
}

#filescroll {
    height: 1fr;
    border: round $accent;
}
#fileview {
    padding: 0 1;
}

#ticker {
    dock: bottom;
    height: 10;
    border: round $warning;
    background: $surface;
}

/* Responsive: stack the right column under the task table on narrow terminals. */
Screen.-narrow #working {
    layout: vertical;
}
Screen.-narrow #tasks,
Screen.-narrow #side,
Screen.-narrow #navcol {
    width: 1fr;
}

/* Onboarding + launcher + home spacing. */
#intro, #hometitle {
    padding: 1 1;
}
#setupbtns, #homebtns, #scoperow, #judgerow {
    height: auto;
    padding: 1 0;
}
#agentsel {
    height: 1fr;
    border: round $primary;
}
#newrun {
    padding: 1 2;
}
